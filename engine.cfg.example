#==============================================================================
# ENGINE CONFIG (template — STARTING-DEFAULTS REFERENCE)
#==============================================================================
# hot-reload: press 'r' in the TUI to apply changes without restarting
# (except symbol, testnet, warmup_ticks — those need a restart)
#
# NOTE (2026-04-25): this template is a starting-defaults reference and may
# lag behind engine.cfg. Phase 8 added: fee_rate_maker / fee_rate_taker.
# Phase 8a: depth_enabled + record_depth. Phase 8b: notify_enabled +
# notify_backend + notify_command + notify_cooldown_secs. Phase 6prep:
# confidence_window + confidence_freshness_tau + confidence_threshold_scale.
# Phase 7prep: held_out_fraction + gap_acceptable_threshold. The live
# engine.cfg has these documented; copy from there if you need a current
# template. Defaults in code are the source of truth — see
# `ControllerConfig_Default` in `CoreFrameworks/ControllerConfig.hpp`.
#==============================================================================

# data source
symbol=btcusdt                  # binance trading pair
use_testnet=0                   # 1 = use binance testnet (fake data, safe for testing)
use_binance_us=0                # 1 = use binance US endpoint instead of global
poll_timeout_ms=100             # how long to wait for new data before running engine tick (ms)
reconnect_delay=5               # seconds to wait before reconnecting after disconnect

# session lifecycle
wind_down_minutes=5             # minutes before 24h boundary to stop new buys and wind down

# warmup phase
warmup_ticks=128                # minimum raw ticks before trading
min_warmup_samples=128          # wait for short window to fill (128 × poll_interval ≈ 71 min at BTC rate)

# v5.9.2c — CSV tick-sort validation (backtest only; live uses ordered WS)
#   0 = warn   (default — log violations, proceed with potentially-garbage features)
#   1 = strict (refuse load on any violation; abort backtest run)
#   2 = auto   (sort the array in-place, log INFO with violation count)
# Without this guard, unsorted CSVs (concatenated daily exports, mistyped
# tick replays) silently produce garbage rolling stats / ROR / tick-rate
# features at training time.
csv_sort_check_mode=0           # warn — change to 1 if your tick CSVs should never be unsorted

#==============================================================================
# REGRESSION GATE
#==============================================================================
# the engine uses P&L regression to shift the buy gate — if we're making money,
# buy more aggressively; if losing, tighten up. these control that feedback loop.

poll_interval=100               # ticks between slow-path runs (regression, adaptation, etc)
r2_threshold=0.30               # min R² to trust regression (0-1, higher = more conservative)
slope_scale_buy=0.50            # how much P&L slope shifts the buy price (higher = more reactive)
max_shift=0.001                 # max buy gate drift as fraction of price (0.001 = 0.1% = ~$70 at BTC $70k)

#==============================================================================
# PAPER TRADING
#==============================================================================
starting_balance=10000.00       # initial paper trading balance ($)
fee_rate=0.10                   # trading fee per side (%, 0.10 = 0.1% per trade)
risk_pct=05.00                  # fraction of balance per position (%, 15 = $1500 at $10k balance)
slippage_pct=0.05               # simulated execution slippage (%, 0 = disabled, 0.05 = 0.05% worse on entry/exit)

#==============================================================================
# EXIT CONDITIONS
#==============================================================================
# TP and SL are computed from rolling volatility (stddev) at fill time.
# these percentages are multiplied by 100 to get the stddev multiplier:
# e.g. 6.00% → 6.0x stddev. at stddev=$10, TP = entry + $60, SL = entry - $25.
# percentage fallback is used when rolling stats aren't ready yet.

take_profit_pct=3.00          # take profit (%, also used as stddev multiplier)
stop_loss_pct=1.50             # stop loss (%, also used as stddev multiplier)

#==============================================================================
# ENTRY FILTERS
#==============================================================================
# these control WHEN the strategy buys. adapted by P&L regression at runtime.
# initial values set here, then the engine loosens/tightens based on performance.

volume_multiplier=3.00          # only buy when tick volume >= this * rolling avg (filters noise)
entry_offset_pct=0.15           # buy gate offset below rolling mean (%, 0.15 = 0.15% dip required)
spacing_multiplier=2.00         # min distance between entries = stddev * this (prevents clustering)

# how far the adaptive filters can drift from initial values
offset_min=0.05                 # most aggressive offset (%, smallest dip to buy)
offset_max=0.50                 # most defensive offset (%, largest dip required)
vol_mult_min=1.50               # most aggressive volume filter (lowest multiplier)
vol_mult_max=6.00               # most defensive volume filter (highest multiplier)
filter_scale=0.50               # how fast filters adapt (higher = faster response to P&L)

#==============================================================================
# RISK MANAGEMENT
#==============================================================================
max_drawdown_pct=10.00          # halt ALL buying if total P&L drops below this % of starting balance
max_exposure_pct=50.00          # max % of balance deployed in open positions
max_positions=1                 # max simultaneous open positions (1-16)

#==============================================================================
# ENHANCED BUY SIGNAL
#==============================================================================
# stddev-scaled offset: buy_price = avg - (stddev * mult)
# scales with volatility — wider dips required in volatile markets, tighter in calm ones
# set to 0 to use percentage-based offset instead

offset_stddev_mult=1.50         # stddev multiplier for buy offset (0 = use entry_offset_pct instead)
offset_stddev_min=0.50          # adaptation lower bound (most aggressive, 0.5 stddev dip)
offset_stddev_max=4.00          # adaptation upper bound (most defensive, 4.0 stddev dip)

# multi-timeframe gate: blocks buys when the 512-tick window shows a downtrend
# uses relative slope (slope/price), so the same value works on any asset at any price
# negative = allow mild drops, 0 = disabled
min_long_slope=-0.00005         # block when price dropping faster than 0.005%/tick

#==============================================================================
# TRAILING TAKE-PROFIT
#==============================================================================
# when price runs past the original TP in a strong trend, the TP ratchets up
# to trail the price. captures extended runs instead of exiting at the first target.
# hold_score = (slope/stddev) * R² — requires the trend to be BOTH strong AND consistent.
# set tp_hold_score to 0 to disable (use fixed TP).

tp_hold_score=0.15              # min score to hold past TP (0 = disabled, 0.1-0.3 typical)
tp_trail_mult=1.00              # trailing TP distance in stddevs below price (0.5-2.0 recommended)
sl_trail_mult=2.00              # trailing SL distance in stddevs below price (wider than TP)
fee_floor_mult=3.00             # TP floor = entry × fee_rate × this (3.0 = 2x round-trip + 1x margin)
min_sl_tp_ratio=0.50            # min SL distance as fraction of TP distance (0.5 = 2:1 reward/risk)
ror_tp_bonus=1.20               # TP multiplier when trend is accelerating (1.2 = 20% wider)
momentum_tp_r2_min=0.50         # TP scale at R²=0 (0.5 = half base TP when uncertain)
momentum_sl_r2_max=1.50         # SL scale at R²=0 (1.5 = wider SL in choppy markets)

#==============================================================================
# ADAPTATION SPEED
#==============================================================================
# controls how fast the engine adjusts filters based on P&L regression
# higher = more aggressive adaptation, lower = slower/smoother changes

squeeze_decay=0.10              # idle squeeze rate per cycle (10% of gap toward floor)
offset_adapt_scale=0.001        # P&L regression → offset_pct shift strength
stddev_adapt_scale=0.10         # P&L regression → stddev/breakout shift strength
vol_adapt_scale=0.10            # P&L regression → volume_mult shift strength
breakout_min=0.50               # momentum breakout floor in stddevs (idle squeeze target)
slow_path_max_secs=3            # wall-time floor between slow-path cycles (seconds)

#==============================================================================
# TIME-BASED EXIT
#==============================================================================
# close positions held too long with insufficient gain. frees capital trapped
# in positions where TP became unreachable (e.g. volatility dropped after entry).
# only closes if gain is below min_hold_gain_pct — profitable positions are kept.

max_hold_ticks=50000            # close after this many ticks (~4-5 hours at 3 ticks/sec)
min_hold_gain_pct=0.10          # only time-exit if gain < this % (0.10 = 0.1%)

#==============================================================================
# REGIME DETECTION
#==============================================================================
# classifies market as RANGING (mean reversion), TRENDING (momentum), or VOLATILE (pause)
# uses rolling price slope, R², and stddev to determine regime
# hysteresis prevents rapid switching between strategies

regime_slope_threshold=0.00002  # relative slope for TRENDING detection (≈$180 move over 128 ticks at BTC $70k)
regime_r2_threshold=70.00       # min R² consistency for TRENDING (%, 70 = 0.70)
regime_volatile_stddev=0.0005   # stddev/price ratio for VOLATILE detection (legacy, kept for compat)
regime_vol_spike_ratio=2.0      # variance spike: short/long variance > this = volatile (self-adapting)
regime_hysteresis=5             # slow-path cycles before regime switch (5 = ~2.5 min at BTC rate)

#==============================================================================
# MOMENTUM STRATEGY
#==============================================================================
# buys breakouts ABOVE the rolling average (opposite of mean reversion)
# activates when regime detector identifies TRENDING market

momentum_breakout_mult=1.50     # buy when price > avg + stddev * this (1.5 = 1.5σ above avg)
momentum_tp_mult=3.00           # TP distance in stddevs (wider than MR to let trends run)
momentum_sl_mult=1.00           # SL distance in stddevs (tighter than MR, cut losers fast)

#==============================================================================
# TUI
#==============================================================================
tui_enabled=1                   # 0 = headless mode (for VPS/tmux), 1 = terminal dashboard
tui_render_interval=10          # render every N ticks (higher = less terminal thrash)
log_file=engine.log             # stderr redirect when tui_enabled=0 (append mode, tail -f friendly)

#==============================================================================
# LIVE TRADING (experimental, untested)
#==============================================================================
# requires secrets.cfg with api_key and api_secret (gitignored, never commit)
# US users: get keys from binance.us (Account Settings > API Management) and set use_binance_us=1
# global users: get keys from binance.com, or testnet from testnet.binance.vision
# WARNING: use at your own risk — not validated on a live exchange

use_real_money=0                # 0 = paper trading (default safe), 1 = real orders via REST API
# use_binance_us=1              # uncomment for Binance US (required for US-based users)

# v5.7.2 — hardcoded strategy boot guard. AUTO (regime-gated) is the
# recommended assignment for live capital because hardcoded strategies
# fire regardless of regime classification (the 2026-04-30 audit showed
# the "MOM enters in RANGING" pattern came from Core 0 hardcoded MOM,
# not classifier failure). When use_real_money=1 AND any core has a
# hardcoded strategy, boot ERRORS unless this flag is set to 1.
# Paper runs always boot with a WARN regardless. Set to 1 only if you
# explicitly want a hardcoded strategy in live mode (e.g. running a
# specific strategy comparison, or know the regime context for the
# session).
acknowledge_hardcoded_strategy_in_live=0

#==============================================================================
# KILL SWITCH
#==============================================================================
# halts trading when session losses exceed threshold. resets at session boundary.
# press 'k' in TUI to manually reset.

kill_switch_enabled=1           # 0 = disabled, 1 = active
kill_switch_daily_loss_pct=3.00 # halt if equity drops this % from session start
kill_switch_drawdown_pct=5.00   # halt if this % below intra-session peak
kill_recovery_warmup=10         # slow-path cycles to observe after kill reset before re-entering

#==============================================================================
# EMA GATE
#==============================================================================
# optional proactive buy gate: smooths price into an EMA, only buys below it.
# prevents buying into extended rallies. disabled by default.

gate_ema_enabled=0              # 0 = disabled, 1 = gate buys below EMA
gate_ema_alpha=0.997            # EMA smoothing (0.99 = fast, 0.999 = slow)

#==============================================================================
# DANGER GRADIENT
#==============================================================================
# tightens buy gate proportionally as price drops below rolling avg.
# at crash_stddevs, gate is fully zeroed (no buys during crashes).

danger_enabled=1                # 0 = disabled, 1 = active
danger_warn_stddevs=3.0         # gate begins tightening at this σ below avg
danger_crash_stddevs=6.0        # gate fully zeroed at this σ (crash protection)

#==============================================================================
# VOL-SCALED SIZING
#==============================================================================
# scales position size inversely with volatility — smaller in volatile markets,
# larger in calm ones. targets consistent risk per trade.

vol_sizing_enabled=0            # 0 = fixed risk_pct, 1 = vol-scaled
vol_scale_min=0.25              # minimum scale factor (0.25 = at least 25% of base qty)
vol_scale_max=2.00              # maximum scale factor (2.0 = at most 200% of base qty)

#==============================================================================
# NO-TRADE BAND
#==============================================================================
# suppresses entries when the buy signal is too weak to clear round-trip fees.

no_trade_band_enabled=1         # 0 = disabled, 1 = active
no_trade_band_mult=3.00         # signal must exceed fee_rate × this to trade

#==============================================================================
# SESSION FILTERS
#==============================================================================
# per-session volume gate multipliers (UTC). higher = more selective.
# liquidity varies by session — US has deepest books, Asian thinnest.

session_filter_enabled=0        # 0 = disabled, 1 = apply session multipliers
session_asian_mult=1.50         # 00-07 UTC
session_european_mult=1.20      # 07-13 UTC
session_us_mult=0.80            # 13-20 UTC
session_overnight_mult=1.30     # 20-00 UTC

#==============================================================================
# GATE RECOVERY
#==============================================================================
# prevents permanent lockout after consecutive losses

idle_reset_cycles=50            # slow-path cycles with no fill before gate decay
sl_cooldown_cycles=5            # slow-path cycles to pause after stop loss
sl_cooldown_adaptive=1          # 0 = fixed cycles, 1 = scale by trend confidence at SL time

#==============================================================================
# PARTIAL EXITS
#==============================================================================
# split exits: take partial profit at TP1, ride remainder to TP2

partial_exit_enabled=0          # 0 = single exit at TP, 1 = split exits
partial_exit_pct=0.50           # fraction to exit at TP1 (0.50 = 50%)
tp2_mult=2.00                   # TP2 = TP1 distance × this
breakeven_on_partial=1          # move SL to breakeven after TP1 hit

#==============================================================================
# ENGINE ARCHITECTURE (v5.0.0+)
#==============================================================================
# engine_arch — slow-path threading model under sharded mode.
#   per_core_slow (default since v5.0.0): each engine = self-contained
#                  strategy unit (slow + hot pthread pair). N slow-path
#                  threads spawn at boot, each runs RebuildOneCore +
#                  TimeExitOneCore + TrailingSLRatchetOneCore for its
#                  own core. Producer thread keeps global work
#                  (RollingStats, depth, snapshot save, GUI publish).
#                  Real prop-shop architecture; matches Xeon-class deploy.
#   centralized   (legacy): producer thread runs slow-path for all cores
#                  in one loop. Available for benchmark / regression
#                  comparison. Functionally equivalent (shared OneCore
#                  helpers); just a different threading topology.
# STARTUP-ONLY — changes ignored on hot reload.
engine_arch=per_core_slow

# v5.0.2: slow_path_pin_offset — CPU pinning policy for slow-path threads
# (only used when engine_arch=per_core_slow).
#   -1 = no pin (OS-scheduled — original v5.0 behavior)
#    0 = auto-derive (base = num_execution_cores + 2, past the drainer)
#   >0 = explicit base CPU. Slow-path c pins to (offset + c) mod nproc.
# Default 0 (auto). HT-sharing acceptable since slow-paths are jitter-tolerant.
# slow_path_pin_offset=0

# Optional: per-core slow-path cadence override.
# core_N_poll_interval=N — fast strategies (momentum) may want tighter
# rebuilds; slow strategies (MR) tolerate longer. 0 (or absent) = inherit
# global poll_interval.
# core_0_poll_interval=50
# core_1_poll_interval=100

#==============================================================================
# ML INFERENCE
#==============================================================================
# XGBoost or LightGBM model for buy signals. train in foxml_suite, load here.
# model must match current MODEL_FORMAT_VERSION or it will be rejected.

ml_backend=0                    # 0 = disabled, 1 = xgboost, 2 = lightgbm
ml_model_path=                  # path to buy-signal model file (e.g. models/buy_signal.xgb)
ml_buy_threshold=0.50           # prediction threshold for buy signal (0.50 = 50% confidence)

#==============================================================================
# FOXML INTEGRATION
#==============================================================================
# shared ML modules ported from FoxML Python stack. all default OFF.

cost_gate_enabled=0             # suppress entries when estimated trade cost > TP target
foxml_vol_scaling_enabled=0     # scale position size inversely with volatility
foxml_vol_scaling_z_max=3.0     # z-score clipping threshold for vol scaler
bandit_enabled=0                # blend regime strategy with Exp3-IX bandit weights
bandit_blend_ratio=0.30         # max bandit influence fraction (ramps from 0% to this)
confidence_enabled=0            # dynamic buy threshold from prediction quality scoring
# v5.9.1 — confidence hard-floor. Hard-block ML entries when raw confidence
# is below this value, INDEPENDENT of damping. Default 0.0 = disabled
# (preserves pre-v5.9.1 behavior). Audit-recommended once confidence is
# stable: 0.05. Only consulted when confidence_enabled=1. Surfaced via the
# strategy_halt_reason channel as SHALT_LOW_CONFIDENCE.
confidence_hard_block_threshold=0.0   # recommended after retrain: 0.05

#==============================================================================
# PER-CORE OVERRIDES (v4.0)
#==============================================================================
# Each execution core (0..15) can override any of the fields below. Empty or
# 0 = inherit from the global value above. Set to override for that core only.
#
# Use cases:
#   - A/B test the same strategy with different tunings on different cores
#   - Run riskier momentum on Core 0 vs conservative MR on Core 1
#   - Test ml_buy_threshold sensitivity per core without touching the global
#
# Cfg syntax: core_<N>_<field>=<value>. The field name matches the global.
# All examples below are commented out — uncomment + edit to use, OR use the
# Settings panel's per-core tabs in engine_gui to edit them visually.
#
# Trading
# core_0_take_profit_pct=4.0
# core_1_take_profit_pct=6.0
# core_0_stop_loss_pct=2.0
# core_0_fee_floor_mult=3.0
#
# Entry filters
# core_0_entry_offset_pct=0.150
# core_0_volume_multiplier=1.50
# core_0_spacing_multiplier=2.50
# core_0_offset_stddev_mult=2.00
#
# Strategy-specific (only consulted when this core runs the matching strategy)
# core_0_simpledip_tp_pct=3.0
# core_0_simpledip_sl_pct=1.5
# core_1_mr_tp_pct=2.5
# core_1_mr_sl_pct=1.25
# core_2_momentum_tp_mult=3.0
# core_2_momentum_sl_mult=1.0
# core_3_emacross_tp_pct=4.0
# core_3_emacross_sl_pct=2.0
# core_0_ml_tp_pct=1.5
# core_0_ml_sl_pct=0.8
# core_0_ml_buy_threshold=0.55

# ===========================================================================
# v5.4.0 Phase 0.1 — operational health log (always-available diagnostic)
# ===========================================================================
# Structured JSONL diagnostic log. When health_log_path is non-empty, the
# engine appends a line per Health_Log call with timestamp, category, and
# message. Useful for ongoing operational visibility without code changes.
#
# Categories used by the engine: engine, regime, sl_emission, sg_eval,
# cooldown, latency, fee_accounting, strategy_adapt.
# Levels: 0=info (always), 1=debug, 2=trace.
#
# Empty path = disabled (zero overhead). Non-empty = JSONL output.
#
# Example (uncomment to enable):
# health_log_path=logs/foxml-health.jsonl
# health_log_level=0
#
# v5.9.4 — log rotation policy. Without rotation, long soaks accumulate
# multi-GB JSONL files. Rotation atomically renames to <path>.<unix_ts_us>
# when size exceeds max_bytes; keep_count controls retention.
# health_log_max_bytes=104857600    # 100 MB (default 0 = no rotation)
# health_log_keep_count=7           # keep last 7 rotated files (default 0)

#==============================================================================
# HELD-OUT VALIDATION + STAMP-BASED MODEL ATTESTATION (v5.2.0+, refined v5.8.6+)
#==============================================================================
# held_out_fraction: portion of training data reserved as final-test set.
#   Code refuses access during training/tuning; explicit unlock required.
# gap_acceptable_threshold: |WF mean - held_out| > this = poor generalization.
#   Used by foxml_suite's "Run Full Validation" button to accept or refuse
#   auto-stamping a trained model.
held_out_fraction=0.20
gap_acceptable_threshold=0.05

# Held-out gate (v5.2.0): refuse to load a .bin without a valid .stamp sibling.
# v5.8.6 extends this gate to also catch feature-registry-hash drift (model
# trained against a different FOREACH_FEATURE registry than current build).
# Defaults preserve back-compat with un-stamped models.
#
# PRODUCTION DEPLOY CHECKLIST (live trading with real money):
#   1. Set held_out_stamp_secret to a non-empty random string (e.g.
#      `openssl rand -hex 32`). Same secret in suite + engine.
#   2. Train + Run Full Validation in foxml_suite (auto-stamps the model).
#   3. Verify Stamp button confirms the stamp.
#   4. Flip held_out_gate_strict=1 below — live engine refuses to load
#      any model whose stamp signature, format version, or feature
#      registry hash doesn't match the current build.
# Leaving strict=0 in production is a footgun: a drifted model would
# load with a stderr WARN that nobody sees during normal operation.
held_out_gate_strict=0          # 0=warn-only, 1=refuse load on stamp failure, -1=skip

# v5.9.2b — allow loading a model whose stamp's engine_version differs by
# major version from the current build (e.g. stamp says 5.x but engine is
# 6.x). Cross-major can introduce hot-path predicate changes that make a
# v5-trained model misbehave at v6 inference. Default 0 (refuse cross-major).
# Operator opts in explicitly to deploy older models on newer engines:
#   allow_cross_major_engine=1
# Combined with held_out_gate_strict=0 → engine warns + loads anyway.
allow_cross_major_engine=0      # 0=refuse cross-major (safe), 1=allow with warn

# v5.9.4 — minor-version drift acknowledgment. By default, engine boot
# WARNs when a loaded model's stamp engine_version differs from the
# current build's ENGINE_VERSION_STRING by minor (e.g. stamp says 5.8.x
# on a 5.9.x build). Patch-level drifts (5.9.0a vs 5.9.0b) NOT warned.
# Operator who deliberately deploys cross-minor (typical: stamps from
# previous sprint, loaded on current build) flips this to 1 to suppress.
# Cross-major drift is gated separately by allow_cross_major_engine
# above + the held_out_gate_strict refusal path.
acknowledge_cross_binary_version_drift=0   # 0=warn (safe), 1=suppress minor WARN
held_out_stamp_secret=          # HMAC-SHA256 secret. Empty = devmode (signs but accepts any sig)

# Auto-stamp on held-out completion (v5.3.2 + v5.8.7 + v5.8.10).
# When 1, foxml_suite's "Run Full Validation" button writes a signed stamp
# alongside the trained model file. Stamp body embeds engine_version +
# feature_registry_hash so the live engine can detect drift at load time.
# Default 1 — auto-stamp is the recommended path post-v5.8.7. Flip to 0
# only if you intend to use tools/stamp_model.sh manually (rare).
auto_stamp_on_held_out=1
